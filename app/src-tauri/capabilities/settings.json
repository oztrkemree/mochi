{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "What the settings window may do: tell Mochi's window of a change, and open Mochi at login or not",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
